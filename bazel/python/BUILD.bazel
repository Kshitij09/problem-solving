load("@rules_python//python:defs.bzl", "py_library")
load("@rules_python//python:pip.bzl", "compile_pip_requirements")

exports_files(["pytest_main.py"])

# Collects leetgo testcases.txt files as pytest items; see pytest_leetgo.py.
py_library(
    name = "pytest_leetgo",
    srcs = ["pytest_leetgo.py"],
    imports = ["."],
    visibility = ["//visibility:public"],
    deps = ["@pypi//pytest"],
)

# Regenerate the lock file after editing requirements.in:
#   bazel run //bazel/python:requirements.update
compile_pip_requirements(
    name = "requirements",
    src = "requirements.in",
    requirements_txt = "requirements_lock.txt",
)
