azul_jdk = use_extension("//bazel/jvm:extension.bzl", "azul_jdk")
use_repo(
    azul_jdk,
    "zulu_jdk_25_macos_aarch64",
    "zulu_jdk_25_macos_aarch64_toolchain_config_repo",
    "zulu_jdk_25_macos_x64",
    "zulu_jdk_25_macos_x64_toolchain_config_repo",
    "zulu_jdk_25_linux_x64",
    "zulu_jdk_25_linux_x64_toolchain_config_repo",
    "zulu_jdk_25_linux_aarch64",
    "zulu_jdk_25_linux_aarch64_toolchain_config_repo",
)

register_toolchains(
    "@zulu_jdk_25_macos_aarch64_toolchain_config_repo//:all",
    "@zulu_jdk_25_macos_x64_toolchain_config_repo//:all",
    "@zulu_jdk_25_linux_x64_toolchain_config_repo//:all",
    "@zulu_jdk_25_linux_aarch64_toolchain_config_repo//:all",
)
